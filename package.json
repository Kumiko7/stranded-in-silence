{
  "name": "stranded-in-silence",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Stranded in Silence - a 4-player co-op horror extraction game in the browser.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "signal": "tsx src/server/index.ts",
    "dev:all": "concurrently -n web,signal -c cyan,magenta \"npm:dev\" \"npm:signal\""
  },
  "dependencies": {
    "preact": "^10.29.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/three": "^0.185.3",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.2.0",
    "ws": "^8.21.1"
  },
  "engines": {
    "node": ">=22"
  }
}

{
  "name": "stranded-in-silence",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Stranded in Silence - a 4-player co-op horror extraction game in the browser.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "validate:art": "node scripts/validateArt.mjs",
    "validate:gen": "node scripts/validateGeneration.mjs"
  },
  "dependencies": {
    "peerjs": "^1.5.5",
    "preact": "^10.29.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/three": "^0.185.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.0"
  },
  "engines": {
    "node": ">=22"
  }
}

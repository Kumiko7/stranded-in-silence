{
  "name": "stranded-in-silence",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Stranded in Silence - a 4-player co-op horror extraction game in the browser.",
  "productName": "Stranded in Silence",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "electron:dev": "electron .",
    "electron:dist": "npm run build && electron . --dist",
    "electron:build": "npm run build && electron-builder",
    "typecheck": "tsc --noEmit",
    "validate:art": "node scripts/validateArt.mjs",
    "validate:gen": "node scripts/validateGeneration.mjs",
    "validate:locales": "node scripts/validateLocales.mjs"
  },
  "dependencies": {
    "peerjs": "^1.5.5",
    "preact": "^10.29.8",
    "three": "^0.185.1",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@types/three": "^0.185.3",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.0"
  },
  "engines": {
    "node": ">=22"
  },
  "build": {
    "appId": "com.strandedinsilence.game",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.games"
    }
  }
}

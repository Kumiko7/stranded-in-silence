{
  "$doc": "Map pool. Each entry binds an art pack to generation + enemy overrides. Adding a map = add an art pack under art/packs/<id>/ and one entry here. No logic changes.",

  "defaultMapId": "mansion",
  "randomOption": {
    "enabled": true,
    "nameKey": "map.random.name",
    "posterArtId": "poster.random"
  },

  "maps": {
    "test": {
      "nameKey": "map.test.name",
      "descKey": "map.test.desc",
      "artPack": "test",
      "posterArtId": "poster.test",
      "enabled": true,
      "enemies": [],
      "overrides": {
        "graphics": {
          "ambientIntensity": 1.5,
          "ambientColor": "#38405e",
          "fog": { "color": "#080a10", "density": 0.045 }
        }
      }
    },

    "mansion": {
      "nameKey": "map.mansion.name",
      "descKey": "map.mansion.desc",
      "artPack": "mansion",
      "posterArtId": "poster.mansion",
      "enabled": true,
      "enemies": ["ghost"],
      "$note": "Ambient is deliberately low but above graphics.json -> minAmbientFloor: the manor lights itself with candles, a fire in most rooms and moonlight through the windows, and the fog does the rest.",
      "overrides": {
        "world": {
          "grid": { "width": 6, "height": 6 },
          "doors": { "lockedDoorCount": 2 }
        },
        "graphics": {
          "fog": { "color": "#0a0b12", "density": 0.05 },
          "ambientColor": "#232a3d",
          "ambientIntensity": 0.95
        }
      },
      "ambienceTrack": "ambience/mansion_loop",
      "musicTrack": "music/mansion_tension"
    }
  }
}

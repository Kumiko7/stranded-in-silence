{
  "$doc": "Item catalogue. `artId` resolves against art/shared/props/items. Logic only ever reads this file + the item's behaviour id; art is fully swappable. See docs/art/ART_GUIDE.md.",

  "$roster": "Every item is SINGLE USE. `useMode` says how the hand button drives it: `hold` fills a ring while the button is down, `throw` draws an arc while the button is down and releases on let-go, `none` means the item does nothing in the hand and only pays out on escape, `pickup` means it is consumed the instant you touch it and never enters a slot.",

  "sizeClass": {
    "$doc": "All world items occupy this bounding box so room art knows how much space to leave on a spawn anchor.",
    "width": 0.35,
    "depth": 0.35,
    "height": 0.4
  },

  "defaults": {
    "pickupRange": 2.2,
    "dropForwardOffset": 0.6,
    "throw": {
      "$doc": "Shared by every throwable. The arc is a plain ballistic curve so the preview and the flight are the same integration - what you see is exactly where it goes.",
      "$collision": "Throwables ignore room furniture and containers: with 2D collision a flask would otherwise die on a table leg it visibly flew over. They stop on walls, the floor, closed doors, players and the hunter.",
      "speed": 12.0,
      "gravity": 17.0,
      "radius": 0.12,
      "releaseHeightOffset": -0.12,
      "maxFlightSeconds": 5.0,
      "ceilingClearance": 0.25,
      "ceilingBounce": 0.25,
      "aim": {
        "$doc": "The preview arc drawn while the use button is held. One bead every `sampleSeconds` of flight - at 12 m/s that is a bead roughly every 40 cm, which reads as a line without becoming one.",
        "sampleSeconds": 0.035,
        "maxPoints": 120
      }
    }
  },

  "items": {
    "key": {
      "nameKey": "item.key.name",
      "descKey": "item.key.desc",
      "artId": "item.key",
      "behaviour": "unlock",
      "useMode": "hold",
      "consumedOnUse": true,
      "params": { "unlockSeconds": 1.2, "range": 2.2 }
    },
    "medicine": {
      "nameKey": "item.medicine.name",
      "descKey": "item.medicine.desc",
      "artId": "item.medicine",
      "behaviour": "heal",
      "useMode": "hold",
      "consumedOnUse": true,
      "params": { "useSeconds": 3.0, "toState": "healthy", "range": 2.2 }
    },
    "flashbang": {
      "nameKey": "item.flashbang.name",
      "descKey": "item.flashbang.desc",
      "artId": "item.flashbang",
      "behaviour": "flash",
      "useMode": "throw",
      "consumedOnUse": true,
      "params": {
        "radius": 9.0,
        "enemyStunSeconds": 5.0,
        "playerStunSeconds": 2.2,
        "blindSeconds": 3.2,
        "burstSeconds": 1.1
      }
    },
    "alarmClock": {
      "nameKey": "item.alarmClock.name",
      "descKey": "item.alarmClock.desc",
      "artId": "item.alarmClock",
      "behaviour": "alarm",
      "useMode": "throw",
      "consumedOnUse": true,
      "params": { "durationSeconds": 14.0, "ringIntervalSeconds": 0.9 }
    },
    "tarFlask": {
      "nameKey": "item.tarFlask.name",
      "descKey": "item.tarFlask.desc",
      "artId": "item.tarFlask",
      "behaviour": "tar",
      "useMode": "throw",
      "consumedOnUse": true,
      "params": { "radius": 2.2, "slowMultiplier": 0.28, "durationSeconds": 22.0, "spreadSeconds": 0.6 }
    },
    "barricade": {
      "nameKey": "item.barricade.name",
      "descKey": "item.barricade.desc",
      "artId": "item.barricade",
      "behaviour": "barricade",
      "useMode": "hold",
      "consumedOnUse": true,
      "params": { "placeSeconds": 2.2, "openSeconds": 9.0, "range": 2.4 }
    },
    "coinPile": {
      "nameKey": "item.coinPile.name",
      "descKey": "item.coinPile.desc",
      "artId": "item.coinPile",
      "behaviour": "coins",
      "useMode": "pickup",
      "consumedOnUse": true,
      "occupiesSlot": false,
      "params": { "minValue": 25, "maxValue": 60 }
    },
    "diamond": {
      "nameKey": "item.diamond.name",
      "descKey": "item.diamond.desc",
      "artId": "item.diamond",
      "behaviour": "treasure",
      "useMode": "none",
      "consumedOnUse": false,
      "params": { "value": 400 }
    }
  }
}

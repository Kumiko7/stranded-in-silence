{
  "$doc": "Default action bindings. Logic never reads raw key codes - it reads ACTION ids. Rebinding writes overrides into the save profile; this file is the reset-to-default source.",

  "actions": {
    "moveForward": { "labelKey": "input.moveForward", "keys": ["KeyW", "ArrowUp"], "category": "movement" },
    "moveBack": { "labelKey": "input.moveBack", "keys": ["KeyS", "ArrowDown"], "category": "movement" },
    "moveLeft": { "labelKey": "input.moveLeft", "keys": ["KeyA", "ArrowLeft"], "category": "movement" },
    "moveRight": { "labelKey": "input.moveRight", "keys": ["KeyD", "ArrowRight"], "category": "movement" },
    "sprint": { "labelKey": "input.sprint", "keys": ["ShiftLeft"], "category": "movement", "mode": "hold" },
    "crouch": { "labelKey": "input.crouch", "keys": ["ControlLeft"], "category": "movement", "mode": "hold" },

    "interact": { "labelKey": "input.interact", "keys": ["KeyE"], "category": "interaction", "mode": "pressOrHold" },
    "useLeft": { "labelKey": "input.useLeft", "keys": ["Mouse0"], "category": "interaction" },
    "useRight": { "labelKey": "input.useRight", "keys": ["Mouse2"], "category": "interaction" },
    "dropLeft": { "labelKey": "input.dropLeft", "keys": ["KeyQ"], "category": "interaction" },
    "dropRight": { "labelKey": "input.dropRight", "keys": ["KeyF"], "category": "interaction" },

    "pushToTalk": { "labelKey": "input.pushToTalk", "keys": ["KeyV"], "category": "voice", "mode": "hold" },
    "toggleVoiceMute": { "labelKey": "input.toggleVoiceMute", "keys": ["KeyM"], "category": "voice" },

    "chat": { "labelKey": "input.chat", "keys": ["Enter"], "category": "system" },

    "pauseMenu": { "labelKey": "input.pauseMenu", "keys": ["Escape"], "category": "system", "rebindable": false },
    "toggleFullscreen": {
      "labelKey": "input.toggleFullscreen",
      "keys": ["F11"],
      "category": "system"
    },
    "scoreboard": { "labelKey": "input.scoreboard", "keys": ["Tab"], "category": "system", "mode": "hold" },

    "$spectate": "Deliberately the movement keys. A spectator is not moving, so nothing is competing for them, and 'the keys I already walk with' is one less thing to be told. `giveUp` sits on Space for the same reason: there is no jump in this game, so the biggest key on the board is free.",
    "spectateNext": { "labelKey": "input.spectateNext", "keys": ["KeyD", "ArrowRight"], "category": "system" },
    "spectatePrev": { "labelKey": "input.spectatePrev", "keys": ["KeyA", "ArrowLeft"], "category": "system" },
    "giveUp": { "labelKey": "input.giveUp", "keys": ["Space"], "category": "system", "mode": "hold" }
  },

  "$keyLabels": "What gets printed on the key cap the HUD draws. These are the only keyboard words a player ever sees, which is why they live here rather than in code (docs/LOCALISATION.md) - a layout that calls a key something else is a config edit. Anything not listed falls back to the raw code with its Key/Digit prefix stripped, so letters and digits need no entry. `Mouse<n>` codes are never listed: they are drawn as a mouse with the pressed button lit, not as a word.",
  "keyLabels": {
    "ShiftLeft": "Shift",
    "ShiftRight": "Shift",
    "ControlLeft": "Ctrl",
    "ControlRight": "Ctrl",
    "AltLeft": "Alt",
    "AltRight": "Alt",
    "MetaLeft": "Meta",
    "MetaRight": "Meta",
    "Space": "Space",
    "Escape": "Esc",
    "Enter": "Enter",
    "NumpadEnter": "Enter",
    "Tab": "Tab",
    "Backspace": "Bksp",
    "CapsLock": "Caps",
    "ArrowUp": "↑",
    "ArrowDown": "↓",
    "ArrowLeft": "←",
    "ArrowRight": "→",
    "Backquote": "`",
    "Minus": "-",
    "Equal": "=",
    "BracketLeft": "[",
    "BracketRight": "]",
    "Backslash": "\\",
    "Semicolon": ";",
    "Quote": "'",
    "Comma": ",",
    "Period": ".",
    "Slash": "/"
  },

  "$wideKeys": "Codes whose cap is drawn wider, because the word on it does not fit a square.",
  "wideKeys": ["ShiftLeft", "ShiftRight", "ControlLeft", "ControlRight", "Space", "Escape", "Enter", "NumpadEnter", "Backspace", "CapsLock", "AltLeft", "AltRight", "MetaLeft", "MetaRight"],

  "mouse": {
    "sensitivity": 1.0,
    "sensitivityRange": [0.1, 5.0],
    "invertY": false,
    "smoothing": 0.0
  },

  "gamepad": {
    "enabled": false
  },

  "holdDefaults": {
    "$doc": "Per-interaction hold times live with the thing being interacted with (world.json / player.json). This is just the input-layer repeat guard.",
    "repeatDelaySeconds": 0.25
  }
}

{
  "$doc": "Mixer buses, spatial audio, the SFX registry and the music director. Every gameplay sound is triggered by a logic `soundId`; how that id is produced is swappable without touching logic.",

  "$note": "Every sound has BOTH a `synth` recipe (rendered by Tone.js at boot, see src/audio/recipes.ts) and a `files` list. A file wins whenever it is actually present under assets/audio/ - drop one in and it replaces the synthesised version with no code change. An entry with neither is legal: it logs once and plays nothing.",

  "buses": {
    "master": { "defaultVolume": 0.8 },
    "music": { "defaultVolume": 0.5, "parent": "master" },
    "sfx": { "defaultVolume": 0.9, "parent": "master" },
    "ambience": { "defaultVolume": 0.6, "parent": "master" },
    "voice": { "defaultVolume": 1.0, "parent": "master" },
    "ui": { "defaultVolume": 0.7, "parent": "master" }
  },

  "spatial": {
    "$doc": "PannerNode settings for positional sounds. Distance only - nothing in this game occludes sound.",
    "distanceModel": "inverse",
    "refDistance": 2.0,
    "rolloffFactor": 1.4,
    "maxDistance": 40.0,
    "panningModel": "HRTF"
  },

  "sounds": {
    "$doc": "soundId -> { bus, synth, files[], volume, pitchRange, loop, spatial, cooldownSeconds }. `files` are relative to assets/audio/. `spatial: false` forces a sound to stay 2D even when logic gives it a position.",

    "ui.hover": { "bus": "ui", "synth": "ui.hover", "files": ["sfx/ui_hover.ogg"], "volume": 0.35, "cooldownSeconds": 0.04 },
    "ui.click": { "bus": "ui", "synth": "ui.click", "files": ["sfx/ui_click.ogg"], "volume": 0.7 },
    "ui.back": { "bus": "ui", "synth": "ui.back", "files": ["sfx/ui_back.ogg"], "volume": 0.7 },

    "player.footstep.walk": { "bus": "sfx", "synth": "footstep.walk", "files": ["sfx/footstep_walk.ogg"], "volume": 0.5, "pitchRange": [0.92, 1.08] },
    "player.footstep.sprint": { "bus": "sfx", "synth": "footstep.sprint", "files": ["sfx/footstep_sprint.ogg"], "volume": 0.8, "pitchRange": [0.95, 1.05] },
    "player.footstep.crouch": { "bus": "sfx", "synth": "footstep.crouch", "files": ["sfx/footstep_crouch.ogg"], "volume": 0.3, "pitchRange": [0.94, 1.06] },
    "player.injured": { "bus": "sfx", "synth": "player.injured", "files": ["sfx/player_injured.ogg"], "volume": 1.0 },
    "player.downed": { "bus": "sfx", "synth": "player.downed", "files": ["sfx/player_downed.ogg"], "volume": 1.0 },
    "player.revive.loop": { "bus": "sfx", "synth": "player.revive", "files": ["sfx/player_revive_loop.ogg"], "volume": 0.6, "loop": true },
    "player.healed": { "bus": "sfx", "synth": "player.healed", "files": ["sfx/player_healed.ogg"], "volume": 0.8 },
    "player.heartbeat": { "bus": "sfx", "synth": "player.heartbeat", "files": ["sfx/player_heartbeat.ogg"], "volume": 0.9, "loop": true, "spatial": false },

    "door.open": { "bus": "sfx", "synth": "door.open", "files": ["sfx/door_open.ogg"], "volume": 0.7, "pitchRange": [0.9, 1.12] },
    "door.close": { "bus": "sfx", "synth": "door.close", "files": ["sfx/door_close.ogg"], "volume": 0.75, "pitchRange": [0.94, 1.06] },
    "door.locked": { "bus": "sfx", "synth": "door.locked", "files": ["sfx/door_locked.ogg"], "volume": 0.6, "cooldownSeconds": 0.35 },
    "door.unlock": { "bus": "sfx", "synth": "door.unlock", "files": ["sfx/door_unlock.ogg"], "volume": 0.8 },

    "chest.open.loop": { "bus": "sfx", "synth": "chest.rummage", "files": ["sfx/chest_open_loop.ogg"], "volume": 0.7, "loop": true },
    "chest.opened": { "bus": "sfx", "synth": "chest.opened", "files": ["sfx/chest_opened.ogg"], "volume": 0.9 },
    "locker.enter": { "bus": "sfx", "synth": "locker.enter", "files": ["sfx/locker_enter.ogg"], "volume": 0.6 },
    "locker.exit": { "bus": "sfx", "synth": "locker.exit", "files": ["sfx/locker_exit.ogg"], "volume": 0.6 },
    "item.pickup": { "bus": "sfx", "synth": "item.pickup", "files": ["sfx/item_pickup.ogg"], "volume": 0.6 },
    "item.drop": { "bus": "sfx", "synth": "item.drop", "files": ["sfx/item_drop.ogg"], "volume": 0.6 },

    "item.throw": { "bus": "sfx", "synth": "item.throw", "files": ["sfx/item_throw.ogg"], "volume": 0.5, "pitchRange": [0.94, 1.08], "spatial": false },
    "item.impact": { "bus": "sfx", "synth": "item.impact", "files": ["sfx/item_impact.ogg"], "volume": 0.85, "pitchRange": [0.92, 1.1] },
    "item.flash": { "bus": "sfx", "synth": "item.flash", "files": ["sfx/item_flash.ogg"], "volume": 1.0 },
    "item.alarm.loop": { "bus": "sfx", "synth": "item.alarm", "files": ["sfx/item_alarm_loop.ogg"], "volume": 0.85, "loop": true },
    "item.tar.spill": { "bus": "sfx", "synth": "item.tar", "files": ["sfx/item_tar_spill.ogg"], "volume": 0.8 },
    "item.medicine.loop": { "bus": "sfx", "synth": "item.medicine", "files": ["sfx/item_medicine_loop.ogg"], "volume": 0.6, "loop": true },
    "item.barricade.loop": { "bus": "sfx", "synth": "item.barricade", "files": ["sfx/item_barricade_loop.ogg"], "volume": 0.7, "loop": true },
    "item.barricade.placed": { "bus": "sfx", "synth": "item.barricadePlaced", "files": ["sfx/item_barricade_placed.ogg"], "volume": 0.9 },
    "item.barricade.broken": { "bus": "sfx", "synth": "item.barricadeBroken", "files": ["sfx/item_barricade_broken.ogg"], "volume": 1.0 },
    "item.coins": { "bus": "sfx", "synth": "item.coins", "files": ["sfx/item_coins.ogg"], "volume": 0.7, "spatial": false },
    "item.treasure": { "bus": "sfx", "synth": "item.treasure", "files": ["sfx/item_treasure.ogg"], "volume": 0.8, "spatial": false },

    "enemy.idle.loop": { "bus": "sfx", "synth": "enemy.idle", "files": ["sfx/enemy_idle_loop.ogg"], "volume": 0.7, "loop": true },
    "enemy.alerted": { "bus": "sfx", "synth": "enemy.alerted", "files": ["sfx/enemy_alerted.ogg"], "volume": 0.9, "spatial": false },
    "enemy.chase.sting": { "bus": "sfx", "synth": "enemy.sting", "files": ["sfx/enemy_chase_sting.ogg"], "volume": 1.0, "spatial": false },
    "enemy.attack": { "bus": "sfx", "synth": "enemy.attack", "files": ["sfx/enemy_attack.ogg"], "volume": 1.0 },

    "exit.hold.loop": { "bus": "sfx", "synth": "exit.hold", "files": ["sfx/exit_hold_loop.ogg"], "volume": 0.7, "loop": true },
    "exit.escaped": { "bus": "sfx", "synth": "exit.escaped", "files": ["sfx/exit_escaped.ogg"], "volume": 1.0, "spatial": false },
    "run.wiped": { "bus": "sfx", "synth": "run.wiped", "files": ["sfx/run_wiped.ogg"], "volume": 1.0, "spatial": false }
  },

  "cues": {
    "$doc": "Which soundId a piece of logic fires. Kept here so retriggering a different sound for an event is a config edit.",

    "noiseSounds": {
      "$doc": "NoiseKind -> soundId. Every peer broadcasts its noise, so this is what makes teammates audible across the map. An empty string is silent.",
      "$note": "doorOpen/doorSlam are silent here on purpose: door STATE is replicated, so doors sound from the state change instead - which is also how a door the hunter opens is heard by everyone.",
      "walk": "player.footstep.walk",
      "sprint": "player.footstep.sprint",
      "crouch": "player.footstep.crouch",
      "doorOpen": "",
      "doorSlam": "",
      "chestOpen": "chest.opened",
      "lockerEnter": "locker.enter",
      "itemDrop": "item.drop",
      "injured": "player.injured",
      "voice": "",
      "$items": "throwImpact / alarm / blast / wreck are silent here on purpose. Every peer simulates the same thrown arc and every peer is told when a barricade comes down, so each one plays the sound itself - sounding it from the noise event as well would double it up for whoever caused it.",
      "throwImpact": "",
      "alarm": "",
      "blast": "",
      "wreck": ""
    },
    "selfFlat": {
      "$doc": "Noise kinds that play flat (non-positional) when they are your own. Panning your own footsteps around your head sounds wrong.",
      "kinds": ["walk", "sprint", "crouch"]
    },
    "alertStings": {
      "$doc": "Fired once when the enemy ENTERS an alert level. Levels come from enemy.json -> alert.levels.",
      "suspicious": "enemy.alerted",
      "alerted": "enemy.alerted",
      "chasing": "enemy.chase.sting"
    },
    "holdLoops": {
      "$doc": "InteractTarget kind -> looping soundId, played at the target while the hold ring is filling.",
      "chest": "chest.open.loop",
      "exit": "exit.hold.loop",
      "revive": "player.revive.loop",
      "forceOpen": "item.barricade.loop"
    },
    "itemUseLoops": {
      "$doc": "Item BEHAVIOUR -> looping soundId, played while a hand button is held on a usable item.",
      "heal": "item.medicine.loop",
      "barricade": "item.barricade.loop"
    },
    "holdLoopEndRate": 1.25,
    "heartbeatMaxRate": 2.4
  },

  "music": {
    "$doc": "A generative score. Four layers cross-fade on one intensity value; drop a file in for a layer and it replaces that layer's synthesis wholesale.",

    "crossfadeSeconds": 2.5,
    "duckOnVoiceDb": -4,
    "bpm": 96,
    "rootHz": 55,

    "intensityByAlert": {
      "$doc": "Where the score sits at each enemy alert level. `proximityWeight` lets nearness alone push it up while the enemy is still calm.",
      "calm": 0.0,
      "suspicious": 0.35,
      "alerted": 0.7,
      "chasing": 1.0
    },
    "proximityWeight": 0.5,
    "chaseLayerThreshold": 0.5,

    "layers": {
      "menu": { "files": ["music/menu.ogg"], "volume": 0.85 },
      "explore": { "files": ["music/explore.ogg"], "volume": 0.5 },
      "tension": { "files": ["music/tension.ogg"], "volume": 0.65 },
      "chase": { "files": ["music/chase.ogg"], "volume": 0.9 },
      "ambience": { "files": ["ambience/room.ogg"], "volume": 0.8 }
    }
  }
}

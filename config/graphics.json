{
  "$doc": "Rendering + lighting. There is no player flashlight - every room lights itself, and `minAmbientFloor` is the hard 'dark but never blind' guarantee. Maps override these via config/maps.json.",

  "pixelRatioCap": 2.0,
  "antialias": true,
  "toneMapping": "aces",
  "exposure": 0.95,

  "ambientIntensity": 0.09,
  "ambientColor": "#2a2f45",
  "minAmbientFloor": 0.05,

  "shadows": {
    "enabled": true,
    "type": "pcfsoft",
    "mapSize": 1024,
    "maxCastingLights": 4
  },

  "fog": {
    "enabled": true,
    "type": "exp2",
    "color": "#0a0b12",
    "density": 0.045,
    "near": 2.0,
    "far": 26.0
  },

  "renderDistanceRooms": 3
}

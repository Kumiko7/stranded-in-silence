{
  "$doc": "Player movement, health, interaction and noise. Units: metres, seconds, radians.",

  "body": {
    "radius": 0.32,
    "standHeight": 1.8,
    "crouchHeight": 1.05,
    "eyeHeightOffset": -0.15,
    "downedEyeHeight": 0.45,
    "heightLerpSpeed": 9.0
  },

  "movement": {
    "walkSpeed": 2.6,
    "sprintSpeed": 4.6,
    "crouchSpeed": 1.35,
    "injuredSpeedMultiplier": 1,
    "acceleration": 28.0,
    "deceleration": 34.0,
    "$note": "Movement is speed-uniform in every direction on purpose - walking backwards while watching the enemy carries no penalty."
  },

  "camera": {
    "fovDegrees": 75,
    "mouseSensitivity": 0.0022,
    "invertY": false,
    "pitchClampDegrees": 88
  },

  "health": {
    "states": ["healthy", "injured", "downed", "dead"],
    "startState": "healthy",
    "injuredBleedOut": false,
    "downedBleedOut": false,
    "reviveHoldSeconds": 6.0,
    "reviveInterruptedResetsProgress": false,
    "reviveRange": 1.6,
    "revivedToState": "injured",
    "invulnerableSecondsAfterHit": 5.0,
    "invulnerableSecondsAfterRevive": 3.0
  },

  "interaction": {
    "rayLength": 2.6,
    "rayRadius": 0.12,
    "highlightWhenLookingAt": true,
    "holdCancelOnMove": false,
    "holdCancelOnLookAway": true,
    "lookAwayGraceSeconds": 0.25
  },

  "noise": {
    "$doc": "Emitted noise events. `radius` is the metre radius at which the enemy can perceive it (see enemy.json hearing). A loudness of 0 is genuinely silent - never heard, and no ring on the roster HUD.",
    "$note": "`injured` is currently unused: injury costs speed, not stealth, so an injured player emits the same walk/sprint/crouch noise as a healthy one.",
    "footstepIntervalWalk": 0.52,
    "footstepIntervalSprint": 0.34,
    "footstepIntervalCrouch": 0.85,
    "walk": { "radius": 5.0, "loudness": 0.15 },
    "sprint": { "radius": 22.0, "loudness": 1.0 },
    "crouch": { "radius": 2.0, "loudness": 0.0 },
    "doorOpen": { "radius": 10.0, "loudness": 0.0 },
    "doorSlam": { "radius": 18.0, "loudness": 0.0 },
    "chestOpen": { "radius": 24.0, "loudness": 1.0 },
    "lockerEnter": { "radius": 6.0, "loudness": 0.0 },
    "itemDrop": { "radius": 8.0, "loudness": 0.0 },
    "voice": { "radius": 12.0, "loudness": 0.6 },
    "injured": { "radius": 14.0, "loudness": 1.0 }
  },

  "customisation": {
    "$doc": "What the wardrobe in the lobby offers. One colour for now; more options land with step 43, and each one is an entry here plus a control in the wardrobe panel.",
    "defaultColourId": "slate",
    "colours": [
      { "id": "slate", "nameKey": "cosmetic.colour.slate", "hex": "#6f7690" },
      { "id": "rust", "nameKey": "cosmetic.colour.rust", "hex": "#9c5638" },
      { "id": "moss", "nameKey": "cosmetic.colour.moss", "hex": "#5f7a52" },
      { "id": "plum", "nameKey": "cosmetic.colour.plum", "hex": "#7a5570" },
      { "id": "sand", "nameKey": "cosmetic.colour.sand", "hex": "#b09b6f" },
      { "id": "teal", "nameKey": "cosmetic.colour.teal", "hex": "#3f7d80" },
      { "id": "ember", "nameKey": "cosmetic.colour.ember", "hex": "#b8823a" },
      { "id": "ash", "nameKey": "cosmetic.colour.ash", "hex": "#8a8b86" }
    ]
  },

  "effects": {
    "$doc": "Screen feedback. Distances in metres, measured enemy -> local player.",
    "heartbeatStartDistance": 22.0,
    "heartbeatMaxDistance": 4.0,
    "vignetteInjuredIntensity": 0.45,
    "vignetteDownedIntensity": 0.8,
    "chaseDistortionIntensity": 0.6,
    "damageFlashSeconds": 0.35
  }
}
